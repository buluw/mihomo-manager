MIHOMO_BINARY_PATH=/opt/mihomo-manager/bin/mihomo
MIHOMO_DATA_DIR=/var/lib/mihomo-manager
MIHOMO_CONFIG_PATH=/var/lib/mihomo-manager/configs/debian-development.yaml
MIHOMO_BOOTSTRAP_PATH=/var/lib/mihomo-manager/bootstrap.yaml
MIHOMO_PROVIDER_DIR=/var/lib/mihomo-manager/providers
MIHOMO_RULE_PROVIDER_DIR=/var/lib/mihomo-manager/ruleset
CONFIGD_RUNTIME_DIR=/var/lib/mihomo-manager/generated-runtime
CONFIGD_HOST=127.0.0.1
CONFIGD_PORT=9081
LOGD_HOST=127.0.0.1
LOGD_PORT=9082
SYSINFO_HOST=127.0.0.1
SYSINFO_PORT=9083
CORE_UPDATE_DIR=/var/lib/mihomo-manager/core-update
ACCESS_DATA_DIR=/var/lib/mihomo-manager/access
LOGD_DB_PATH=/var/lib/mihomo-manager/logs/mihomo-logs.sqlite
LOGD_DEFAULT_RETENTION_DAYS=7
# 日常采集 info；排错时显式改为 debug 并重启 logd
LOGD_CONTROLLER_LOG_LEVEL=info
MIHOMO_CONTROLLER_URL=http://127.0.0.1:19090
