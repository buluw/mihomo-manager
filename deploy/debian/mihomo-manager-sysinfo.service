[Unit]
Description=Mihomo Manager System Information and Website Access
After=network-online.target
PartOf=mihomo-manager.target

[Service]
Type=simple
User=mihomo-manager
Group=mihomo-manager
WorkingDirectory=/opt/mihomo-manager/app/sysinfo
EnvironmentFile=/etc/mihomo-manager/manager.env
ExecStart=/opt/mihomo-manager/node/bin/node dist/index.js
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mihomo-manager/core-update
# Deployment supplies the configured authentication directory in 20-access-data.conf.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=mihomo-manager.target
